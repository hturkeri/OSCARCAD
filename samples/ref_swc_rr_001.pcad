   "exposed": true,
   "label": "n_sec",
   "step": 0,
   "group": ""
  },
  {
   "name": "w_sec",
   "expr": "4",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "4 secondary slot width",
   "exposed": true,
   "label": "w_sec",
   "step": 0,
   "group": ""
  },
  {
