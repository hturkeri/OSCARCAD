   "min": null,
   "max": null,
   "description": "2 flare wall (measured radially/axially, not normal to the cone)",
   "exposed": true,
   "label": "wall_flare",
   "step": 0,
   "group": ""
  },
  {
   "name": "x_flare",
   "expr": "22",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "22 : flare start (inner cone leaves Ø27 bore); dim 22 + 8",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "D_flare_in",
   "expr": "D0+2*(L_total-x_flare)/tan(a_flare/2)",
