   "min": null,
   "max": null,
   "description": "Ø43 flare inner exit diameter at x = 30",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "D_flare_out",
   "expr": "D_flare_in+2*wall_flare",
