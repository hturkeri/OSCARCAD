{
 "schema": "persistcad/1",
 "name": "Enjektor_09-DB01_Simplex",
 "parameters": [
  {
   "name": "Q",
   "expr": "1.90",
   "kind": "scalar",
   "min": 1.9,
   "max": 7.5,
   "description": "[S] Nominal debi @ test basıncı [kg/h] (EN 293: 0.50 USgal/h = 1.90 kg/h)",
   "exposed": true,
   "label": "Debi Q [kg/h]",
   "step": 0.05,
   "group": "Akış"
  },
  {
   "name": "dP",
   "expr": "10",
   "kind": "scalar",
   "min": 7,
   "max": 20,
   "description": "[S] Püskürtme basınç farkı [bar] (EN 293 test: 10 bar)",
   "exposed": true,
   "label": "Basınç ΔP [bar]",
   "step": 0.5,
   "group": "Akış"
  },
  {
   "name": "Cd",
   "expr": "0.1283",
   "kind": "scalar",
   "min": 0.08,
   "max": 0.45,
   "description": "[T] Etkin boşaltma katsayısı: çizilen d0=0.36 ve 1.90 kg/h @10 bar ile kalibre (SPEC §6)",
   "exposed": true,
   "label": "Boşaltma katsayısı Cd",
   "step": 0.005,
   "group": "Akış"
  },
  {
   "name": "d0_mod",
   "expr": "0",
   "kind": "count",
   "min": 0,
   "max": 1,
   "description": "Orifis modu: 0 = Ø debiden hesaplanır (Q, ΔP, Cd); 1 = elle verilen d0_el kullanılır",
   "exposed": true,
   "label": "Orifis modu (0: debiden, 1: elle Ø)",
   "step": 1,
   "group": "Akış"
  },
  {
   "name": "d0_el",
   "expr": "0.36",
   "kind": "length",
   "min": 0.2,
   "max": 1.0,
   "description": "[Ö] Orifis çapı, elle (çizim: Ø0.36) — yalnız d0_mod=1 iken etkin",
   "exposed": true,
   "label": "Orifis Ø (elle) [mm]",
   "step": 0.01,
   "group": "Akış"
  },
  {
   "name": "Lo",
   "expr": "0.28",
   "kind": "length",
   "min": 0.15,
   "max": 1.0,
   "description": "[Ö] Orifis silindirik boyu (çizim 0.28, L/d=0.78)",
   "exposed": true,
   "label": "Orifis boyu Lo [mm]",
   "step": 0.01,
   "group": "Akış"
  },
  {
   "name": "Ds",
   "expr": "1.52",
   "kind": "length",
   "min": 1.2,
   "max": 4.0,
   "description": "[Ö] Girdap odası giriş çapı (H24, Ø1.52)",
   "exposed": true,
   "label": "Girdap odası Ø Ds [mm]",
   "step": 0.02,
   "group": "Akış"
  },
  {
   "name": "alfa_s",
   "expr": "69.2",
   "kind": "angle",
   "min": 60,
   "max": 120,
   "description": "[Ö] Girdap odası koni tam açısı (çizim 69.2°)",
   "exposed": true,
   "label": "Girdap odası koni açısı [°]",
   "step": 0.5,
   "group": "Akış"
  },
  {
   "name": "rho",
   "expr": "817",
   "kind": "scalar",
   "min": 700,
   "max": 1000,
   "description": "[S] Test yağı yoğunluğu [kg/m³] (ISO 4113, 37.8 °C)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "nu_cSt",
   "expr": "3.5",
   "kind": "scalar",
   "min": 1,
   "max": 10,
   "description": "[S] Test yağı kinematik viskozitesi [cSt]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "mu",
   "expr": "rho*nu_cSt/1000000",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Dinamik viskozite [Pa·s]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "d0_hes",
   "expr": "1000*sqrt(4*(Q/3600)/(Cd*pi*sqrt(2*rho*dP*100000)))",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Orifis çapı debiden: ṁ = Cd·(π d0²/4)·√(2ρΔP)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "d0",
   "expr": "(1-d0_mod)*d0_hes + d0_mod*d0_el",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Kullanılan orifis çapı [mm]",
   "exposed": false,
   "label": "Orifis çapı d0",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "n_slot",
   "expr": "2",
   "kind": "count",
   "min": 1,
   "max": 4,
   "description": "[V] VARSAYIM: teğetsel slot adedi (çizimde yalnız 1 slot görünür; 1–4 hepsi tutarlı)",
   "exposed": true,
   "label": "Slot adedi (VARSAYIM)",
   "step": 1,
   "group": "Swirler"
  },
  {
   "name": "w_slot",
   "expr": "0.16",
   "kind": "length",
   "min": 0.1,
   "max": 0.5,
   "description": "[Ö] Slot genişliği (0.16 ± 0.03)",
   "exposed": true,
   "label": "Slot genişliği w [mm]",
   "step": 0.01,
   "group": "Swirler"
  },
  {
   "name": "h_slot",
   "expr": "0.19",
   "kind": "length",
   "min": 0.1,
   "max": 0.3,
   "description": "[Ö] Slot derinliği, 110° koni yüzeyine dik (0.19 ± 0.04)",
   "exposed": true,
   "label": "Slot derinliği h [mm]",
   "step": 0.01,
   "group": "Swirler"
  },
  {
   "name": "e_slot",
   "expr": "0.20",
   "kind": "length",
   "min": 0.05,
   "max": 0.5,
   "description": "[Ö] Slot ekseninin nozul ekseninden kaçıklığı (0.20 ± 0.05); e ≤ Ds/2 − w/2",
   "exposed": true,
   "label": "Slot eksen kaçıklığı e [mm]",
   "step": 0.01,
   "group": "Swirler"
  },
  {
   "name": "koni_on",
   "expr": "110",
   "kind": "angle",
   "min": 100,
   "max": 120,
   "description": "[Ö] Yuva / swirler uç konisi tam açısı (110°)",
   "exposed": true,
   "label": "Uç (yuva) konisi açısı [°]",
   "step": 1,
   "group": "Swirler"
  },
  {
   "name": "koni_arka",
   "expr": "60",
   "kind": "angle",
   "min": 50,
   "max": 70,
   "description": "[Ö] Swirler arka konisi tam açısı (60°)",
   "exposed": true,
   "label": "Arka koni açısı [°]",
   "step": 1,
   "group": "Swirler"
  },
  {
   "name": "d_uc",
   "expr": "0.80",
   "kind": "length",
   "min": 0.5,
   "max": 1.1,
   "description": "[Ö] Swirler uç düzlüğü çapı (Ø0.80)",
   "exposed": true,
   "label": "Uç düzlüğü Ø [mm]",
   "step": 0.05,
   "group": "Swirler"
  },
  {
   "name": "slot_uc_payi",
   "expr": "d_uc/2 - h_slot/cos(koni_on/2)",
   "kind": "length",
   "min": 0,
   "max": null,
   "description": "[T] Tasarım bağıntısı: slot tabanı uç düzlüğünde eksene ulaşmamalı (karşılıklı slotlar uçta birleşir, girdap kolu kalmaz)",
   "exposed": false,
   "label": "Slot tabanı–eksen payı (uçta)",
   "step": 0,
   "group": ""
  },
  {
   "name": "slot_ic_payi",
   "expr": "e_slot - w_slot/2",
   "kind": "length",
   "min": 0,
   "max": null,
   "description": "[T] Tasarım bağıntısı: slotun iç duvarı eksen düzlemini geçmemeli (e ≥ w/2), aksi halde akışın bir kısmı ters yönde döner",
   "exposed": false,
   "label": "Slot iç duvarı–eksen düzlemi payı",
   "step": 0,
   "group": ""
  },
  {
   "name": "slot_dis_payi",
   "expr": "Ds/2 - e_slot - w_slot/2",
   "kind": "length",
   "min": 0,
   "max": null,
   "description": "[T] Tasarım bağıntısı: slotun dış duvarı girdap odası yarıçapının içinde kalmalı (e + w/2 ≤ Ds/2)",
   "exposed": false,
   "label": "Slot dış duvarı–girdap odası payı",
   "step": 0,
   "group": ""
  },
  {
   "name": "slot_az",
   "expr": "-75",
   "kind": "angle",
   "min": -180,
   "max": 180,
   "description": "[Ö] 1. slotun açısal konumu: kesit düzleminden izleyiciye doğru ≈75° (diğerleri eşit aralıklı [V])",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "elek_goz",
   "expr": "75",
   "kind": "scalar",
   "min": 75,
   "max": 140,
   "description": "[S] Elek göz açıklığı [µm]: 75 (200 mesh, 0.50–0.85 USgal/h) / 140 (120 mesh, 1.00–11.0)",
   "exposed": true,
   "label": "Elek göz açıklığı [µm]",
   "step": 5,
   "group": "Filtre"
  },
  {
   "name": "elek_tel",
   "expr": "52",
   "kind": "scalar",
   "min": 30,
   "max": 80,
   "description": "[V] Elek tel çapı [µm] (kare örgü: 200 mesh → 52, 120 mesh → 72)",
   "exposed": true,
   "label": "Elek tel çapı [µm]",
   "step": 1,
   "group": "Filtre"
  },
  {
   "name": "L_elek",
   "expr": "9.10",
   "kind": "length",
   "min": 7.5,
   "max": 10.8,
   "description": "[Ö] Elek kovanı boyu (çizim 9.10; zarf 20.5 max → ≤ 10.8)",
   "exposed": true,
   "label": "Elek boyu [mm]",
   "step": 0.1,
   "group": "Filtre"
  },
  {
   "name": "pen_aci",
   "expr": "150",
   "kind": "angle",
   "min": 100,
   "max": 160,
   "description": "[V] VARSAYIM: filtre penceresi yay açısı (sıra başına n_pen pencere). Çizim yalnız 0°–90° arasının açık olduğunu gösterir (≥ 100°)",
   "exposed": true,
   "label": "Pencere açısı (VARSAYIM) [°]",
   "step": 5,
   "group": "Filtre"
  },
  {
   "name": "n_pen",
   "expr": "2",
   "kind": "count",
   "min": 2,
   "max": 2,
   "description": "[V] VARSAYIM: sıra başına pencere adedi (köprüler 135° ve 315°'de: çizimde görünmeyen bölgeler)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "pen_merkez",
   "expr": "45",
   "kind": "angle",
   "min": 0,
   "max": 360,
   "description": "[Ö]/[V] 1. pencerenin merkez azimutu: çizimde kesit düzlemi (0°) ve arkadaki çeyrek (0°–90°) tamamen açık → merkez 45°",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "dLf",
   "expr": "L_elek - 9.10",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Elek boyu farkı (iki kanal tabanına eşit paylaştırılır)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "elek_acik",
   "expr": "(elek_goz/(elek_goz+elek_tel))^2",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Elek açık alan oranı (kare örgü)",
   "exposed": false,
   "label": "Elek açık alan oranı",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "elek_mesh",
   "expr": "25400/(elek_goz+elek_tel)",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Mesh sayısı [1/inç]",
   "exposed": false,
   "label": "Elek mesh sayısı [1/inç]",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "n_capraz",
   "expr": "2",
   "kind": "count",
   "min": 1,
   "max": 2,
   "description": "[V] VARSAYIM: çapraz delik adedi (2 = boydan boya delinmiş; kesitte yalnız biri görünür)",
   "exposed": true,
   "label": "Çapraz delik adedi (VARSAYIM)",
   "step": 1,
   "group": "Tutucu vida"
  },
  {
   "name": "d_capraz",
   "expr": "2.40",
   "kind": "length",
   "min": 1.5,
   "max": 3.0,
   "description": "[Ö] Çapraz delik çapı (Ø2.40)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "z_capraz",
   "expr": "3.06",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] Çapraz delik ekseni kotu",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "H_bas",
   "expr": "14.01",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[S] Baş yüksekliği 14 ±0.2 (çizimde 14.01)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "AF_alt",
   "expr": "15.85",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[S] Altıgen anahtar ağzı 16 +0/−0.25 (çizimde 15.85)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "AF_soket",
   "expr": "4.76",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[S] Alyan yuvası SW 3/16\"",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "D_delik",
   "expr": "8.84",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] Baş deliği = 3/8\"-40 UNS iç diş dibi çapı",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "D_dis",
   "expr": "9.48",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] 3/8\"-40 UNS erkek diş üstü çapı (çizim)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "D_vida",
   "expr": "7.48",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] Tutucu vida gövde çapı",
   "exposed": false,
   "label": "",
