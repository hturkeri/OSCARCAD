  },
  {
   "name": "d_vida_delik",
   "expr": "3.90",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] Tutucu vida eksenel deliği",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "d_filtre_delik",
   "expr": "7.40",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] Filtre gövdesi deliği",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "D_etek",
   "expr": "7.60",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] Swirler etek çapı",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "d_sap",
   "expr": "3.70",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] Swirler sap çapı",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "R_tr",
   "expr": "0.48",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] Orifis çıkış trompeti yarıçapı",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "h_tr",
   "expr": "0.28",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] Çıkış trompeti yüksekliği (H2→H3)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "h_havsa",
   "expr": "0.21",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[Ö] Çıkış havşası derinliği (Ø3.98)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "D_zarf",
   "expr": "11.8",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[S] Filtre azami zarf çapı Ø11.8 max = akış hacmi dış sınırı [V: brülör adaptörü deliği]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "L_zarf",
   "expr": "20.5",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[S] Filtre azami zarf boyu 20.5 max = akış hacmi alt sınırı",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "z_f",
   "expr": "H_bas - h_havsa",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Havşa tabanı = trompet sonu (H3, H4)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "z_2",
   "expr": "z_f - h_tr",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Orifis silindirinin sonu (H2)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "z_1",
   "expr": "z_2 - Lo",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Orifis girişi (H1)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "z_24",
   "expr": "z_1 - (Ds-d0)/2/tan(alfa_s/2)",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Girdap odası konisi başlangıcı (H24)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "z_yuva",
   "expr": "z_24 - (4.29-Ds/2)/tan(koni_on/2)",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Yuva konisi başlangıcı (H23), çizimde 9.93",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "z_uc",
   "expr": "z_24 + (Ds-d_uc)/2/tan(koni_on/2)",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Swirler uç düzlüğü (S1,S2), çizimde 12.66",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "z_S3",
   "expr": "z_24 - (2.79-Ds/2)/tan(koni_on/2)",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Uç konisi sonu (S3), çizimde 10.98",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "z_S4",
   "expr": "z_S3 - (3.78-2.79)/tan(koni_arka/2)",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Arka koni sonu (S4), çizimde 9.27",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "z_alt",
   "expr": "z_S4 - 1.21",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Swirler alt yüzü = tutucu vida üst yüzü, çizimde 8.06",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "slot_s0",
   "expr": "-(h_slot*sin(koni_on/2)+0.15)/cos(koni_on/2)",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Slot takımının uç tarafı (anadoğru boyunca, uç düzlüğünü 0.15 aşar)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "slot_s1",
   "expr": "(2.79-d_uc/2)/sin(koni_on/2) + h_slot/tan((koni_on-koni_arka)/2) + 0.3",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[T] Slot takımının arka ucu (arka konide tükenme noktası + 0.3)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_orifis",
   "expr": "pi*d0^2/4",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Orifis alanı [mm²]",
   "exposed": false,
   "label": "Orifis alanı [mm²]",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "A_slot",
   "expr": "n_slot*w_slot*h_slot",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Toplam slot alanı n·w·h [mm²] (ölçüm kesiti)",
   "exposed": false,
   "label": "Slot alanı n·w·h (anma) [mm²]",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "A_slot_etkin",
   "expr": "n_slot*w_slot*(h_slot-(e_slot^2+w_slot^2/12)/Ds*cos(koni_on/2))",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Modeldeki GERÇEK en dar slot kesiti (girdap odası ağzı, r = Ds/2): kaçık düz kanal koni yüzeyine göre sığlaşır; n·w·h'den ≈ %7–9 küçük (OCCT kesit ölçümüyle doğrulandı) [mm²]",
   "exposed": false,
   "label": "Slot en dar kesiti (model) [mm²]",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "A_oda_giris",
   "expr": "pi*((Ds/2-(z_uc-z_24)*tan(alfa_s/2))^2-(d_uc/2)^2)",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Swirler ucu ile girdap odası konisi arasındaki halka [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_kama",
   "expr": "pi*(4.29^2-(3.78-(z_yuva-0.45-z_S4)*tan(koni_arka/2))^2)",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Ø8.58 kademe / arka koni halkası [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_etek",
   "expr": "pi*(D_delik^2-D_etek^2)/4",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Etek/delik halka boşluğu [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_halka",
   "expr": "pi*(D_delik^2-D_vida^2)/4",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Vida/delik halka boşluğu [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_capraz",
   "expr": "n_capraz*pi*d_capraz^2/4",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Çapraz delik(ler) [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_vida_delik",
   "expr": "pi*d_vida_delik^2/4",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Vida eksenel deliği [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_soket",
   "expr": "sqrt(3)/2*AF_soket^2",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Alyan yuvası [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_aralik",
   "expr": "pi*AF_soket*1.05*0.58",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Filtre üstü / vida altı aralığı (0.58 mm, alyan ağzı çevresi) [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_filtre_delik",
   "expr": "pi*d_filtre_delik^2/4",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Filtre gövde deliği [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_pencere",
   "expr": "n_pen*pen_aci/360*2*pi*3.895*(3.20+dLf)",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Filtre pencereleri, 2 sıra (ort. yarıçap 3.895) [mm²] — pencere açısı VARSAYIM",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_elek",
   "expr": "2*pi*4.74*(6.41+dLf)*elek_acik",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Kanal üstü serbest elek açık alanı [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "A_min_diger",
   "expr": "min(min(min(A_oda_giris,A_kama),min(A_etek,A_halka)),min(min(A_capraz,A_vida_delik),min(min(A_soket,A_aralik),min(A_filtre_delik,min(A_pencere,A_elek)))))",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Slot ve orifis dışındaki en dar geçit [mm²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "oran_slot_orifis",
   "expr": "A_slot/A_orifis",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] A_slot / A_orifis",
   "exposed": false,
   "label": "A_slot / A_orifis",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "oran_diger_orifis",
   "expr": "A_min_diger/A_orifis",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] En dar diğer geçit / A_orifis (≫1 olmalı)",
   "exposed": false,
   "label": "En dar diğer geçit / A_orifis",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "K_geo",
   "expr": "A_slot/(Ds*d0)",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Atomizör sabiti K = A_p/(D_s·d0)",
   "exposed": false,
   "label": "Atomizör sabiti K = A_slot/(Ds·d0)",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "Cd_RL",
   "expr": "0.35*K_geo^0.5*(Ds/d0)^0.25",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Rizk–Lefebvre: Cd = 0.35·K^0.5·(Ds/d0)^0.25 (gösterge; mikro/viskoz nozul için doğrulanmamış)",
   "exposed": false,
   "label": "Cd (Rizk–Lefebvre, gösterge)",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "Q_RL",
   "expr": "Cd_RL*A_orifis/1000000*sqrt(2*rho*dP*100000)*3600",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Rizk–Lefebvre Cd ile beklenen debi [kg/h] (gösterge)",
   "exposed": false,
   "label": "Debi (Rizk–Lefebvre, gösterge) [kg/h]",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "FN",
   "expr": "(Q/3600)/sqrt(dP*100000*rho)",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Akış sayısı FN = ṁ/√(ΔP·ρ) [m²]",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "aci_RL",
   "expr": "6*K_geo^(-0.15)*(dP*100000*(d0/1000)^2*rho/mu^2)^0.11",
   "kind": "angle",
   "min": null,
   "max": null,
   "description": "[T] Rizk–Lefebvre püskürtme açısı 2θ = 6·K^−0.15·(ΔP·d0²·ρ/μ²)^0.11 [°] (gösterge)",
   "exposed": false,
   "label": "Püskürtme açısı 2θ (R–L, gösterge)",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "Lo_d0",
   "expr": "Lo/d0",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Orifis L/d",
   "exposed": false,
   "label": "Orifis L/d",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "Ds_d0",
   "expr": "Ds/d0",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Ds/d0 (tipik 2.7–5)",
   "exposed": false,
   "label": "Ds/d0",
   "step": 0,
   "group": "Hesaplanan"
  },
  {
   "name": "v_slot",
   "expr": "(Q/3600)/rho/(A_slot/1000000)",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "[T] Slot ortalama hızı [m/s]",
   "exposed": false,
   "label": "Slot ortalama hızı [m/s]",
   "step": 0,
   "group": "Hesaplanan"
  }
 ],
