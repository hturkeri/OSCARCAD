{
 "schema": "persistcad/1",
 "name": "ATM-PS-001_SimplexAtomizer",
 "parameters": [
  {
   "name": "L_total",
   "expr": "10",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "10 overall length of the assembly (tip + insert), x = 0 at the orifice exit face",
   "exposed": true,
   "label": "L_total",
   "step": 0,
   "group": ""
  },
  {
   "name": "D_out",
   "expr": "8",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "Ø8 nozzle tip outer diameter",
   "exposed": true,
   "label": "D_out",
   "step": 0,
   "group": ""
  },
  {
   "name": "chamfer",
   "expr": "0.5",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "0.5 x 45° outer exit chamfer",
   "exposed": true,
   "label": "chamfer",
   "step": 0,
   "group": ""
  },
  {
   "name": "d0",
   "expr": "0.8",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "Ø0.8 orifice (d0 / do)",
   "exposed": true,
   "label": "d0",
   "step": 0,
   "group": ""
  },
  {
   "name": "D_exit",
   "expr": "2",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "Ø2 exit countersink diameter at the forward face",
   "exposed": true,
   "label": "D_exit",
   "step": 0,
   "group": ""
  },
  {
   "name": "a_exit",
   "expr": "90",
   "kind": "angle",
   "min": null,
   "max": null,
   "description": "90° exit cone included angle",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "L_exit",
   "expr": "(D_exit-d0)/2/tan(a_exit/2)",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "0.6 exit cone length (dimension 0.6)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "lo",
   "expr": "0.4",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "0.4 orifice land length (lo; lo/do = 0.50)",
   "exposed": true,
   "label": "lo",
   "step": 0,
   "group": ""
  },
  {
   "name": "x_c1",
   "expr": "L_exit+lo",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "1.0 : orifice land end / start of the swirl-chamber cone",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "Ds",
   "expr": "3.2",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "Ø3.2 swirl chamber diameter (Ds; Ds/do = 4.0)",
   "exposed": true,
   "label": "Ds",
   "step": 0,
   "group": ""
  },
  {
   "name": "a_cone",
   "expr": "90",
   "kind": "angle",
   "min": null,
   "max": null,
   "description": "90° swirl chamber cone included angle",
   "exposed": true,
   "label": "a_cone",
   "step": 0,
   "group": ""
  },
  {
   "name": "x_c0",
   "expr": "x_c1+(Ds-d0)/2/tan(a_cone/2)",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "2.2 : chamber cylinder start (end of the 90° cone)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "L_tip",
   "expr": "4.2",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "4.2 length of part (1) at its bore / front face of the insert",
   "exposed": true,
   "label": "L_tip",
   "step": 0,
   "group": ""
  },
  {
   "name": "Ls",
   "expr": "L_tip-x_c0",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "2 swirl chamber cylindrical length (Ls; Ls/Ds = 0.625)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "D_bore",
   "expr": "5",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "Ø5 tip counterbore = insert outer diameter",
   "exposed": true,
   "label": "D_bore",
   "step": 0,
   "group": ""
  },
  {
   "name": "L_ins",
   "expr": "L_total-L_tip",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "5.8 swirler insert (2) length",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "n_slot",
   "expr": "3",
   "kind": "count",
   "min": null,
   "max": null,
   "description": "3 tangential slots, eq. sp. 120°",
   "exposed": true,
   "label": "n_slot",
   "step": 0,
   "group": ""
  },
  {
   "name": "slot_w",
   "expr": "0.5",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "0.5 slot width (tangential)",
   "exposed": true,
   "label": "slot_w",
   "step": 0,
   "group": ""
  },
  {
   "name": "slot_d",
   "expr": "0.5",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "0.5 slot depth (axial, into the insert front face)",
   "exposed": true,
   "label": "slot_d",
   "step": 0,
   "group": ""
  },
  {
   "name": "slot_off",
   "expr": "Ds/2-slot_w/2",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "1.35 slot centreline offset from the axis (outer wall tangent to chamber, note 5)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "slot_len",
   "expr": "1.9",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "[interp] slot strip length from the tangent point to the groove (view B)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "groove_w",
   "expr": "0.6",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "0.6 feed groove width",
   "exposed": true,
   "label": "groove_w",
   "step": 0,
   "group": ""
  },
  {
   "name": "groove_d",
   "expr": "0.5",
   "kind": "length",
   "min": null,
   "max": null,
   "description": "0.5 feed groove depth (radial, flat floor)",
   "exposed": true,
   "label": "groove_d",
   "step": 0,
   "group": ""
  },
  {
   "name": "groove_az",
   "expr": "37",
   "kind": "angle",
   "min": null,
   "max": null,
   "description": "[interp] azimuth of feed groove 1 in the model frame (view B: 143° from +u, mirrored)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "Ap",
   "expr": "n_slot*slot_w*slot_d",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "0.75 mm² total slot area (note 3)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  },
  {
   "name": "K",
   "expr": "Ap/(Ds*d0)",
   "kind": "scalar",
   "min": null,
   "max": null,
   "description": "0.29 atomizer constant K = Ap/(Ds*do) (note 4)",
   "exposed": false,
   "label": "",
   "step": 0,
   "group": ""
  }
 ],
